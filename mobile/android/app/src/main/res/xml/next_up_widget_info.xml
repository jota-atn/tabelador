<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Próximo", 2×2. Mesmo snapshot do widget Hoje; ver NextUpWidget.kt. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="300dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/today_schedule_widget_loading"
    android:previewLayout="@layout/next_up_widget_preview"
    android:previewImage="@drawable/next_up_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
