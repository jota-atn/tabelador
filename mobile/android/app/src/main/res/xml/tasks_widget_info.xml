<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de Tarefas. Mesmo snapshot dos outros; ver TasksWidget.kt. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="480dp"
    android:maxResizeHeight="640dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/today_schedule_widget_loading"
    android:previewLayout="@layout/tasks_widget_preview"
