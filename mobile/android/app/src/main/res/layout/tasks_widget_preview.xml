<?xml version="1.0" encoding="utf-8"?>
<!-- Prévia estática do widget de Tarefas no seletor do launcher. Dados
     fictícios; o conteúdo real vem de TasksWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_card_bg"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tarefas" android:textColor="#1C1C1C" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Atrasadas" android:textColor="#B3261E" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <View android:layout_width="3dp" android:layout_height="24dp" android:background="#AB365C" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_marginHorizontal="10dp" android:background="@drawable/widget_preview_caixinha" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entregar relatório · ontem" android:textColor="#1C1C1C" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Hoje" android:textColor="#5C5C5C" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <View android:layout_width="3dp" android:layout_height="24dp" android:background="#3A5BA0" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_marginHorizontal="10dp" android:background="@drawable/widget_preview_caixinha" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lista 3 de Cálculo · 14:00" android:textColor="#1C1C1C" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <View android:layout_width="3dp" android:layout_height="24dp" android:background="#C4C6D0" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_marginHorizontal="10dp" android:background="@drawable/widget_preview_caixinha" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Comprar pão" android:textColor="#1C1C1C" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Esta semana" android:textColor="#5C5C5C" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
        <View android:layout_width="3dp" android:layout_height="24dp" android:background="#6B5778" />
        <View android:layout_width="16dp" android:layout_height="16dp" android:layout_marginHorizontal="10dp" android:background="@drawable/widget_preview_caixinha" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Revisar SO · qui 26" android:textColor="#1C1C1C" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
