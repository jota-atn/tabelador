<?xml version="1.0" encoding="utf-8"?>
<!-- Prévia estática do widget Próximo no seletor do launcher (Android 12+).
     Dados fictícios; o conteúdo real vem de NextUpWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_preview_card_bg"
    android:padding="12dp">

    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="#AB365C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistemas Operacionais"
            android:textColor="#1C1C1C"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="às 10:00"
            android:textColor="#1C1C1C"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="em 25:00"
            android:textColor="#5C5C5C"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Local: Sala 3 · Bloco B"
            android:textColor="#5C5C5C"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
